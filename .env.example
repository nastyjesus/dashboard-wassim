# Variables d'environnement — bridge-proxy-wassim
# ⚠️ Ne committe jamais ce fichier renommé en .env.
#
# Pour le worker Cloudflare, ces variables sont provisionnées via :
#   wrangler secret put <NOM>
#
# Pour le script Node de création des bases Notion, exporte-les avant lancement :
#   export NOTION_TOKEN=...
#   export NOTION_PARENT_PAGE_ID=...
#   node scripts/create-notion-dbs.js

# ─── Bridge API v3 ───
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
BRIDGE_ACCESS_TOKEN=

# ─── Notion ───
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=150fe946b3848040807afe386df26fdd
NOTION_DB_ACCOUNTS_ID=
NOTION_DB_TRANSACTIONS_ID=
NOTION_DB_CATEGORIES_ID=

# ─── Worker auth (front ↔ worker) ───
# Génère un secret long aléatoire (ex: openssl rand -hex 32) et utilise-le
# à la fois dans wrangler secret put WASSIM_AUTH_TOKEN, et dans la page
# Finances → Configuration.
WASSIM_AUTH_TOKEN=

# ─── Switches ───
# "true" tant que les credentials Bridge ne sont pas configurés.
MOCK_MODE=true

# Origines autorisées (CORS), séparées par des virgules.
ALLOWED_ORIGINS=https://nastyjesus.github.io,http://localhost:8000
